rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // Public folder - anyone can read, only admins can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mockups folder - organized by user or product
    match /mockups/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product images - public read, admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Library assets - public read, admin write
    match /library/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User uploads - users can only access their own folder
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Admin-only folder
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
