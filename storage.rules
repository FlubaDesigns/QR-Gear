rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    // Public folder - anyone can read, only admins can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Mockups folder - organized by user or product
    match /mockups/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product images - public read, admin write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared starter assets remain public. Never let this broad rule grant
    // access to library/member: overlapping Storage rules are OR-ed together.
    match /library/{scope}/{allPaths=**} {
      allow read: if scope != 'member';
      allow write: if scope != 'member' && isAdmin();
    }

    // Personal uploads belong only to their owner; validated uploads use the API.
    match /library/member/{memberId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow write: if false;
    }
    match /members/{memberId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == memberId;
      allow write: if false;
    }

    // User uploads - users can only access their own folder
    match /users/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Admin-only folder
    match /admin/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
