modules = ["nodejs-20", "web", "javascript", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "jq", "zip", "libuuid", "imagemagick", "google-cloud-sdk"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[env]
PORT = "5000"

[workflows]

[agent]
integrations = ["javascript_stripe:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_object_storage:2.0.0", "javascript_database:1.0.0", "firebase_barebones_javascript:1.0.0", "stripe:2.0.0", "resend:1.0.0"]

